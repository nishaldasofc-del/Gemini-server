# ---- Required ----
GEMINI_API_KEY=your_google_ai_studio_key   # https://aistudio.google.com/apikey

# ---- Server ----
PORT=3000

# ---- Models (optional overrides) ----
MODEL_BLAZING=gemini-2.5-flash-lite
MODEL_FAST=gemini-2.5-flash
MODEL_BALANCED=gemini-2.5-flash
MODEL_VOICE=gemini-2.5-flash-lite
FALLBACK_MODELS=gemini-2.5-flash-lite

# ---- Voice ----
STT_MODEL=gemini-2.5-flash
TTS_MODEL=gemini-2.5-flash-preview-tts
TTS_VOICE=Kore

# ---- Web search (Tavily) ----
TAVILY_API_KEY=
AUTO_SEARCH=on                 # set to "off" to disable
MAX_SEARCHES_PER_REQUEST=2
SEARCH_TIMEOUT_MS=10000

# ---- Limits (optional) ----
TPM_BUDGET=200000
DEFAULT_MAX_TOKENS=1024
HARD_MAX_TOKENS=16384
FILES_TOKEN_BUDGET=20000
UPSTREAM_TIMEOUT_MS=120000

# ---- Personalisation report (optional) ----
# Base URL of the web app that serves /api/profile (used by the read_user_report tool)
REPORT_API_URL_BASE=https://zenoai-bot.vercel.app
